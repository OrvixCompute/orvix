# ============================================================================
# Orvix Orchestrator — environment configuration
# Copy to `.env` and fill in your values. Never commit `.env`.
# ============================================================================

# --- Core (required) --------------------------------------------------------
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Supabase service_role key (server-side ONLY — bypasses RLS). Keep secret.
SUPABASE_SERVICE_KEY=your-service-role-key
# Secret used to sign JWTs (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
# Runtime environment: dev | prod  (controls log format)
ENVIRONMENT=dev

# --- Core (optional) --------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins, or "*" for all
CORS_ORIGINS=*

# --- Observability (optional) -----------------------------------------------
# Sentry error tracking — get the DSN from your sentry.io project settings.
# Leave empty to disable (no events are sent when unset).
SENTRY_DSN=
# Fraction of transactions traced/profiled (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Auth (optional, sensible defaults) -------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Solana / billing (required only for Prompt 6 payment listener) ---------
# Treasury wallet that receives USDC deposits
TREASURY_WALLET_ADDRESS=
# SPL mint address of USDC (mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v;
# for local testing, use a devnet test mint you control)
USDC_MINT_ADDRESS=
# SPL mint address of ORVX (used to detect provider staking deposits)
ORVX_MINT_ADDRESS=
# Helius API key and RPC base URL
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# How often the payment listener polls (seconds)
POLLING_INTERVAL_SECONDS=15
# Set to true to start the on-chain payment listener at startup
ENABLE_PAYMENT_LISTENER=false

# --- Provider / payouts (optional, sensible defaults) -----------------------
# Percentage of each job's cost paid out to the provider (the rest is protocol margin)
PROVIDER_REWARD_PERCENTAGE=70
# Minimum USDC a provider must accumulate before requesting a withdrawal
MIN_WITHDRAW_AMOUNT_USDC=100.0
# Withdrawals above this amount require manual approval
AUTO_APPROVE_MAX_USDC=10000.0
# Per-user daily withdrawal cap
MAX_WITHDRAWALS_PER_DAY=5
# Simulate on-chain payouts instead of sending real USDC transactions.
# Keep true until the treasury keypair is configured and real payouts are vetted.
PAYOUT_STUB=true
# How often the payout worker processes the withdrawal queue (seconds)
PAYOUT_INTERVAL_SECONDS=300
# Times to poll a payout signature for confirmation (2s apart) before flagging for review
PAYOUT_CONFIRM_MAX_ATTEMPTS=30
# Path to the HOT wallet keypair file (chmod 600). Signs hot->main sweeps.
TREASURY_KEYPAIR_PATH=
# Set to true to start the withdrawal payout worker at startup
ENABLE_PAYOUT_WORKER=false

# --- Treasury architecture (cold/hot/payout) --------------------------------
# NOTE: TREASURY_WALLET_ADDRESS (above) is the HOT wallet — it receives deposits
# and the payment listener subscribes to it. Do NOT reroute it.
# Cold-storage (main) wallet PUBLIC key — private key stays OFFLINE (paper).
TREASURY_MAIN_PUBLIC=
# Payout signer wallet public key + keypair file (chmod 600).
PAYOUT_WALLET_PUBLIC=
PAYOUT_KEYPAIR_PATH=
# Sweep hot->main once hot USDC exceeds this; always leave MIN_KEEP behind.
HOT_SWEEP_THRESHOLD_USDC=100.0
HOT_SWEEP_MIN_KEEP_USDC=10.0
# Simulate the hot->main sweep instead of a real transfer. Keep true until vetted.
TREASURY_SWEEP_STUB=true
# Start the in-process daily sweeper (usually run via the systemd timer instead).
ENABLE_HOT_SWEEPER=false

# --- Staking / tokenomics (whitepaper alignment) ----------------------------
# Enforce the provider stake minimum. Keep false during alpha (providers can
# register without staking); set true before public testnet to require stake.
REQUIRE_STAKE_FOR_PROVIDER=false
# Minimum ORVX a user must stake to register as a compute provider (when enforced)
PROVIDER_MIN_STAKE_ORVX=25000
# How long a staking intent (and its memo) stays valid, in minutes
STAKE_INTENT_TTL_MINUTES=30
# Shared secret for admin buyback/burn endpoints (X-Admin-Key header).
# Generate once, e.g. `openssl rand -hex 32`. Leave blank to disable those endpoints.
ADMIN_API_KEY=

# --- Buyback & burn (admin tooling) -----------------------------------------
# On-chain decimals of the ORVX / USDC SPL tokens
ORVX_DECIMALS=6
USDC_DECIMALS=6
# Simulate on-chain actions instead of sending real transactions.
# Keep BOTH true until devnet-tested and the treasury keypair is configured.
BUYBACK_STUB=true
BURN_STUB=true
# Abort a buyback if Jupiter price impact exceeds this (basis points)
BUYBACK_MAX_SLIPPAGE_BPS=100
# Minimum seconds between buyback executions (drain guard)
BUYBACK_MIN_INTERVAL_SECONDS=300
# Jupiter v6 quote/swap API base URL
JUPITER_QUOTE_API=https://quote-api.jup.ag/v6
# Solana incinerator address (burns SPL tokens sent to it)
INCINERATOR_ADDRESS=1nc1nerator11111111111111111111111111111111
# If set, buyback/burn executions are appended to dated audit files in this dir
AUDIT_LOG_DIR=

# --- Governance (Snapshot.org) ----------------------------------------------
GOVERNANCE_SNAPSHOT_SPACE=orvix
GOVERNANCE_SNAPSHOT_URL=https://snapshot.box/#/orvix

# --- Image generation -------------------------------------------------------
# Seconds to wait for a node to complete an image job (Flux + model swap is slow)
IMAGE_JOB_TIMEOUT=90
# Local dir where generated images are saved (nginx serves it at PUBLIC_IMAGE_URL_BASE)
IMAGE_STORAGE_DIR=/var/orvix/images
# Public base URL mapping to IMAGE_STORAGE_DIR
PUBLIC_IMAGE_URL_BASE=https://orvix.network/images
# Refuse new image jobs once IMAGE_STORAGE_DIR grows past this size (MB)
MAX_IMAGE_STORAGE_MB=5000

# --- Quotas / holder gating -------------------------------------------------
# Minimum ORVX balance (whole tokens) to count as a holder
ORVX_HOLDER_THRESHOLD=10000
# Free lifetime chat requests for non-holders
CHAT_LIFETIME_FREE_LIMIT=2
# Daily image generations for holders (resets 00:00 UTC)
IMAGE_DAILY_LIMIT_HOLDER=5
# Daily image generations for everyone while ORVX_MINT_ADDRESS is unset (grace period)
IMAGE_DAILY_LIMIT_FALLBACK=1
# How long a holder-status lookup is cached (minutes)
HOLDER_CACHE_TTL_MINUTES=15
# Shown when a quota is exhausted
UPGRADE_URL=https://orvix.network/pricing
# Shown when image access needs ORVX
TOKENOMICS_URL=https://orvix.network/tokenomics
