[Unit]
Description=Orvix hot-wallet sweeper (move excess USDC from hot to cold main)
After=network-online.target

[Service]
Type=oneshot
# pydantic-settings loads .env from the working directory.
WorkingDirectory=/opt/orvix/orchestrator
# WorkingDirectory is NOT on sys.path when running a script by path, so make the
# app package importable (sweep_hot.py does `from app... import`).
Environment=PYTHONPATH=/opt/orvix/orchestrator
ExecStart=/opt/orvix/orchestrator/.venv/bin/python scripts/sweep_hot.py
# This job signs with the hot wallet key, so it runs as the owner of that key
# rather than as root. `ubuntu` already owns .env, the keypair files and the
# venv; verified by running scripts/sweep_hot.py by hand as ubuntu. Running it
# as root would also drop root-owned .pyc files into the tree the main service
# runs from.
User=ubuntu
Group=ubuntu
